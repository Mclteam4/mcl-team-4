# Copy to .env.local and fill from Supabase → Project Settings → API.
# NEVER commit .env.local. The service-role key must only ever be used on the server.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (optional in development; in-app notifications work without it)
EMAIL_PROVIDER=smtp            # smtp | resend | none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="MCL Medical Bills <no-reply@example.com>"
